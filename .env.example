# --- SurrealDB (локально в Docker: см. docker-compose) ---
SURREALDB_URL=ws://surrealdb:8000/rpc
SURREALDB_NAMESPACE=chatbot
SURREALDB_DATABASE=main
SURREALDB_USER=root
SURREALDB_PASSWORD=root

# Облачный SurrealDB (разработка без Docker): подставьте свой endpoint и креды
# SURREALDB_URL=wss://your-instance.surreal.cloud/rpc

# --- RAG (FastAPI в Docker или локально) ---
RAG_API_URL=http://rag-api:8000

# Локальная разработка без Docker (rag-api на хосте):
# RAG_API_URL=http://127.0.0.1:8001
WEB_PORT=127.0.0.1:3000
# Эмбеддинги и LLM endpoint для rag-api (OpenAI-совместимо; Ollama — /v1)
OLLAMA_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_OPENAI_EMBEDDING_MODEL=nomic-embed-text

# --- Чат: облако ---
OPENROUTER_API_KEY=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
OPENROUTER_MODEL_DEFAULT=arcee-ai/trinity-large-preview:free
# ALLOWED_OPENROUTER_MODELS=model/a,model/b

# --- Чат: локальный Ollama ---
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
ALLOWED_OLLAMA_MODELS=qwen3:14b,qwen3.6:27b


# Публичный список локальных моделей для UI (JSON-массив строк)
NEXT_PUBLIC_LOCAL_MODELS=["qwen3:14b","qwen3.6:27b"]
