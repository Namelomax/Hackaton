# ── Протоколер: настройки для разработки ───────────────────────────────────
# Приложение запускается на хосте (npm run dev), база — в Docker:
#   docker compose up -d surrealdb
#
# Для установки целиком в Docker этот файл не подходит — используйте
# deploy/contour/env.contour.example. Там же подробные пояснения ко всем
# переменным и варианты подключения языковой модели (deploy/contour/README.md).

# ── Обязательное ────────────────────────────────────────────────────────────
# Пароль root базы. docker compose читает этот же .env, поэтому БД поднимется
# с ним же.  openssl rand -hex 24
SURREALDB_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=
# Логины администраторов через запятую. Первый из них заводится кнопкой
# «Первый вход администратора», остальных пользователей — на /admin.
ADMIN_USERNAMES=

# ── База данных ─────────────────────────────────────────────────────────────
# С хоста — 127.0.0.1, а не surrealdb: этот хост существует только внутри Docker.
SURREALDB_URL=ws://127.0.0.1:8000/rpc
SURREALDB_NAMESPACE=chatbot
SURREALDB_DATABASE=main
SURREALDB_USER=root

# ── Языковая модель ─────────────────────────────────────────────────────────
# Любой OpenAI-совместимый сервер. Здесь — Ollama на этой же машине.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
ALLOWED_OLLAMA_MODELS=qwen3:14b
# Окно модели. Для Ollama — обе переменные, одинаково; для vLLM строку
# LLM_MAX_MODEL_LEN удалить (подробно — deploy/contour/README.md, раздел 3).
OLLAMA_CONTEXT_LENGTH=32768
LLM_MAX_MODEL_LEN=32768
LLM_FORCE_NONSTREAM=false
