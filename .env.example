# --- Точечные правки протокола ---
# off — любая правка пересобирает документ целиком (медленнее, но надёжно).
# Любое другое значение / отсутствие — включён режим точечных замен: правка
# применяется мгновенно, без пересборки.
#
# ПОЧЕМУ СЕЙЧАС OFF. Планировщик замен умеет промахиваться строкой: на стенде
# просили сменить должность одному участнику, а замена легла другому и затёрла
# его собственную. Документ при этом портится МОЛЧА — пользователь видит
# «правка внесена». Пока это не исправлено, лишняя полная генерация дешевле
# тихой порчи. Включать обратно — только после теста на правку с двумя
# должностями в одном предложении.
PROTOCOL_PATCH_MODE=off

# --- Сессии ---
# Секрет подписи сессионных cookie. ОБЯЗАТЕЛЬНО задать в проде: без него сервер
# берёт временный секрет процесса, и после каждого перезапуска все пользователи
# разлогиниваются. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# --- SurrealDB (локально в Docker: см. docker-compose) ---
# Образ по умолчанию v2.6.x (совместим с surrealdb npm ^1.3). Для SurrealDB 3 нужен апгрейд пакета surrealdb в приложении.
# SURREALDB_IMAGE=surrealdb/surrealdb:v2.6.5
SURREALDB_URL=ws://surrealdb:8000/rpc
SURREALDB_NAMESPACE=chatbot
SURREALDB_DATABASE=main
SURREALDB_USER=root
SURREALDB_PASSWORD=root
# Пароль root в контейнере surrealdb (должен совпадать с SURREALDB_PASSWORD):
# SURREAL_ROOT_PASSWORD=root
# Один и тот же том БД на сервере: зафиксируйте имя проекта compose (префикс тома <name>_surreal-data):
# COMPOSE_PROJECT_NAME=forus-chatbot

# Next.js на хосте (npm/bun run dev), Surreal в Docker с пробросом порта — НЕ surrealdb в URL:
# SURREALDB_URL=ws://127.0.0.1:8000/rpc
# Иначе регистрация с ПК не попадёт в БД контейнера на сервере.

# Допустимы алиасы (как в облачных шаблонах): SURREAL_URL, SURREAL_NAMESPACE, SURREAL_DATABASE, SURREAL_USER, SURREAL_PASS

# Облачный SurrealDB (разработка без Docker): подставьте свой endpoint и креды
# SURREALDB_URL=wss://your-instance.surreal.cloud/rpc

# --- RAG (FastAPI в Docker или локально) ---
RAG_API_URL=http://rag-api:8000

# Локальная разработка без Docker (rag-api на хосте):
# RAG_API_URL=http://127.0.0.1:8001
WEB_PORT=127.0.0.1:3000
# Эмбеддинги для rag-api в Docker: http://ollama:11434/v1 (имя сервиса compose). Не 127.0.0.1.
# Явный override для rag-api (если нужен другой хост/порт):
# RAG_LOCAL_OPENAI_BASE_URL=http://ollama:11434/v1
RAG_LOCAL_OPENAI_BASE_URL=http://ollama:11434/v1
LOCAL_OPENAI_EMBEDDING_MODEL=nomic-embed-text
# Размерность вектора и лимит токенов — должны соответствовать выбранной модели:
#   nomic-embed-text  → RAG_EMBEDDING_DIM=768,  RAG_EMBEDDING_MAX_TOKENS=512
#   qwen3-embedding   → RAG_EMBEDDING_DIM=4096, RAG_EMBEDDING_MAX_TOKENS=8000
# При смене модели нужно удалить rag_storage (несовместимые векторы)!
RAG_EMBEDDING_DIM=768
RAG_EMBEDDING_MAX_TOKENS=512

# LLM для индексации в RAG (entity/relation extraction). Должна быть скачана в Ollama:
# docker compose exec ollama ollama pull qwen3:14b
# По умолчанию используется тот же эндпоинт, что и для embeddings.
RAG_OLLAMA_BASE_URL=http://ollama:11434/v1
RAG_OLLAMA_LLM_MODEL=qwen3:14b
# Таймаут одного LLM-вызова в секундах (индексация большого PDF делает десятки/сотни вызовов).
RAG_OLLAMA_LLM_TIMEOUT=600
# Порт Ollama на хосте (для ollama pull с машины): 127.0.0.1:11434
# OLLAMA_HOST_PORT=127.0.0.1:11434

# GPU (NVIDIA): по умолчанию все карты. Одна карта: NVIDIA_VISIBLE_DEVICES=0
# NVIDIA_VISIBLE_DEVICES=all
# Сколько моделей Ollama держит в VRAM одновременно (важно при web + rag-api). По умолчанию в compose: 1.
# OLLAMA_MAX_LOADED_MODELS=1
# Контекст Ollama (токены). ЗДЕСЬ значение только ДИАГНОСТИЧЕСКОЕ: по нему
# resolve-chat-model.ts понимает, что сервер молча отрезал начало промпта.
# Оно ОБЯЗАНО совпадать с OLLAMA_CONTEXT_LENGTH в ~/start-ollama.sh на GPU-хосте,
# иначе предупреждение об обрезке просто не сработает.
#
# Выбор значения — это размен, и он измерен на RTX 3080 (10 ГБ):
#   131072 — gemma4:12b занимает 9.49 ГБ VRAM. Места под модель не остаётся,
#            Ollama выгружает слои на CPU (`offloaded 34/49 layers`), генерация
#            падает с 25 до 18 ток/с, а prompt eval при промахе кэша — до 27 ток/с.
#    16384 — модель влезает целиком, скорость восстанавливается, но длинная
#            расшифровка не помещается и сервер режет НАЧАЛО промпта вместе с
#            системными инструкциями.
#    32768 — практичная середина для 9B-моделей.
OLLAMA_CONTEXT_LENGTH=32768
# OLLAMA_LOAD_TIMEOUT=0
# OLLAMA_DEBUG_LOG_REQUESTS=true
# OLLAMA_LOG_CHAT_REQUEST=1

# Том с моделями Ollama: по умолчанию у chatbot2 создаётся СВОЙ том (пустой), не chatbot_ollama_data.
# Чтобы подключить уже заполненный том chatbot_ollama_data:
#   cp docker-compose.override.example.yml docker-compose.override.yml
#   docker compose up -d --force-recreate ollama
# Либо без override: docker compose -f docker-compose.yml -f docker-compose.ollama-shared.yml up -d --force-recreate ollama
# Важно: два контейнера ollama не должны монтировать один том одновременно.

# --- Чат: облако ---
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_MODEL_DEFAULT=nvidia/nemotron-3-ultra-550b-a55b:free
# ALLOWED_OPENROUTER_MODELS=model/a,model/b

# --- Анонимизатор: GLiNER-NER напрямую (POST {GLINER_URL}/extract) ---
# Основной путь. Задан GLINER_URL → весь пайплайн (чанкинг, параллельные
# прогоны, разрешение перекрытий, канонизация падежей, назначение
# плейсхолдеров) выполняется в lib/anonymization/ на стороне Next.js,
# а GLiNER используется только как NER. ANONYMIZER_URL при этом НЕ нужен.
GLINER_URL=https://oui.interfonica.cloud/gliner
GLINER_API_KEY=
# GLINER_LABELS=person,organization,location,date,email,phone number,contract number
# GLINER_THRESHOLD=0.45
#
# Размер куска, отправляемого в /extract. НЕ поднимать до лимита API
# (50 000 символов): модель перестаёт видеть текст примерно после 1800
# символов и молча возвращает пустой список сущностей — документ
# «анонимизируется» успешно, а ПДн уходят в облако.
# GLINER_MAX_CHARS=800
# Сколько запросов к /extract держать в полёте. Эндпоинт упирается в задержку
# сети (~1.2 с на вызов), а не в вычисления: на документе ~73 000 символов это
# ~356 запросов, то есть ~460 с последовательно против ~31 с в 16 потоков.
# GLINER_CONCURRENCY=16

# --- Старый Python-анонимизатор (server.py /anonymize на отдельном хосте) ---
# Резервный путь: используется, ТОЛЬКО если GLINER_URL не задан. Даёт полный
# пайплайн Python-версии (regex-детекторы, глоссарий, LLM- и review-слои)
# и job-API, снимающее ограничение на длительность одного HTTP-запроса.
# В режиме «Облако + анонимизация» документ и сообщения чистятся от ПДн перед отправкой
# в облачную LLM (соответствие 152-ФЗ). Сервер: python anonymizer/server.py --port 8000 ...
# Через JupyterHub-прокси URL имеет вид https://<hub>/user/<id>/proxy/8000
ANONYMIZER_URL=http://127.0.0.1:8000
# Bearer-токен (для JupyterHub-прокси — тот же, что OLLAMA_API_KEY; для прямого доступа можно пусто)
ANONYMIZER_TOKEN=
# Таймаут ОДНОГО запроса к анонимизатору, мс. Используется только на устаревшем
# синхронном пути (сервер без /jobs). Основной путь — фоновая задача: POST
# /jobs/anonymize отдаёт job_id за миллисекунды, а статус опрашивает БРАУЗЕР,
# поэтому длительность самой анонимизации ничем не ограничена — ни таймаутом
# релея (dev tunnel рубит запрос на ~100 с), ни maxDuration функции Vercel.
# 0 или пусто = без таймаута.
ANONYMIZER_TIMEOUT_MS=0
# Облачная модель, на которую переключается чат в режиме анонимизации
ANONYMIZER_CLOUD_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Чат: локальный Ollama (контейнер ollama в compose — имя сервиса, не host.docker.internal) ---
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MAX_OUTPUT_TOKENS=32768
OLLAMA_FILE_TURN_MAX_OUTPUT_TOKENS=2048
OLLAMA_PROTOCOL_MAX_OUTPUT_TOKENS=32768
OLLAMA_STREAM_HEARTBEAT_MS=15000
ALLOWED_OLLAMA_MODELS=qwen3.5:9b


# Публичный список локальных моделей для UI (JSON-массив строк; первая — выбор по умолчанию)
# NEXT_PUBLIC_LOCAL_MODELS больше не используется в UI (модель фиксирована в коде: qwen3.5:9b)
