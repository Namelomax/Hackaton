# ── Протоколер в контуре компании: .env для docker compose ──────────────────
# Скопировать в корень установки как .env и заполнить. НЕ коммитить.
# Порядок установки: deploy/contour/README.md

# ── Обязательное ────────────────────────────────────────────────────────────
# Пароль root локальной SurrealDB. Задаётся ДО первого запуска: БД создаётся
# с ним, и сменить потом можно только вручную.  openssl rand -hex 24
SURREALDB_PASSWORD=
# Подпись cookie сессий. Без постоянного значения каждый перезапуск
# разлогинивает всех.  openssl rand -hex 32
SESSION_SECRET=
# Логины администраторов через запятую. Регистрации нет — остальных создаёт
# админ на /admin. Если переносите базу из облака, впишите логины, которые там
# уже есть: они станут админами при входе.
ADMIN_USERNAMES=

# ── База данных ─────────────────────────────────────────────────────────────
# Локальная SurrealDB из docker-compose (по умолчанию). Namespace/database —
# любые; при переносе из облака данные импортируются именно сюда.
SURREALDB_NAMESPACE=chatbot
SURREALDB_DATABASE=main
# SURREALDB_URL не задавать: по умолчанию ws://surrealdb:8000/rpc внутри compose.
# Временно работать с облачной БД из контейнера — указать её здесь:
# SURREALDB_URL=wss://<инстанс>.surreal.cloud/rpc
# SURREALDB_USER=<пользователь облака>

# ── LLM (OpenAI-совместимый сервер внутри контура) ─────────────────────────
# Свой сервер компании (vLLM / Ollama / шлюз): его адрес. С профилем ollama из
# compose: http://ollama:11434/v1
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama
# Модель чата: первая из списка (или Qwen3.8-27b-U, если она в списке)
ALLOWED_OLLAMA_MODELS=qwen3:14b
CHAT_PROVIDER_DEFAULT=ollama
# Окно контекста модели. Меняйте ДВЕ переменные вместе, всегда одинаково:
#   OLLAMA_CONTEXT_LENGTH — окно, с которым работает сама модель (прокидывается
#                           в контейнер ollama как num_ctx);
#   LLM_MAX_MODEL_LEN     — окно, под которое приложение режет длину ответа.
# Почему две: vLLM сам сообщает окно в /v1/models, и приложение его подхватывает,
# а Ollama — нет. Без LLM_MAX_MODEL_LEN приложение считает окно равным 32768,
# сколько бы ни стояло в OLLAMA_CONTEXT_LENGTH.
#
# 32768 хватает на обычное совещание. Длинная расшифровка (полтора часа и
# больше) даёт промпт около 32k токенов — на ответ места не остаётся, и сборка
# протокола падает с «Расшифровка слишком большая». Для таких встреч нужно
# 65536 в обеих переменных; это требует больше видеопамяти.
OLLAMA_CONTEXT_LENGTH=32768
LLM_MAX_MODEL_LEN=32768
OLLAMA_MAX_OUTPUT_TOKENS=4096
OLLAMA_PROTOCOL_MAX_OUTPUT_TOKENS=8192
# true — если шлюз не умеет настоящий SSE (отвечает JSON на stream:true).
LLM_FORCE_NONSTREAM=false

# ── RAG: источники папок (docker compose --profile rag up -d) ───────────────
# Пусто — RAG выключен, папки работают только с инструкциями.
RAG_API_URL=
# RAG_API_URL=http://rag-api:8000
RAG_LOCAL_OPENAI_BASE_URL=http://ollama:11434/v1
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_OLLAMA_BASE_URL=http://ollama:11434/v1
RAG_OLLAMA_LLM_MODEL=qwen3:14b

# ── Сеть ────────────────────────────────────────────────────────────────────
# По умолчанию порты слушают только 127.0.0.1 — снаружи через reverse-proxy с
# TLS. Если прокси на другой машине: WEB_PORT=0.0.0.0:3000
WEB_PORT=127.0.0.1:3000
SURREAL_PORT=127.0.0.1:8000
# RAG_API_PORT=127.0.0.1:8001
# OLLAMA_PORT=127.0.0.1:11434
