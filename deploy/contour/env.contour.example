# ── Протоколер: настройки для docker compose ───────────────────────────────
# Скопировать в корень установки как .env и заполнить. В git не класть.
# Порядок установки — README.md, рядом с этим файлом.

# ── Обязательное ────────────────────────────────────────────────────────────
# Пароль root базы данных. Задаётся ДО первого запуска: база создаётся с ним,
# и сменить потом можно только вручную.  openssl rand -hex 24
SURREALDB_PASSWORD=
# Подпись cookie сессий. Без постоянного значения каждый перезапуск
# разлогинивает всех.  openssl rand -hex 32
SESSION_SECRET=
# Логины администраторов через запятую. Самостоятельной регистрации нет —
# остальных пользователей создаёт администратор на /admin. Если переносите
# данные из облачной версии, укажите логины, которые там уже есть: при входе
# они получат права администратора.
ADMIN_USERNAMES=

# ── База данных ─────────────────────────────────────────────────────────────
# Локальная SurrealDB из docker-compose. Адрес задавать не нужно: внутри
# compose он ws://surrealdb:8000/rpc. При переносе данных из облачной версии
# они импортируются именно в эти namespace/database.
SURREALDB_NAMESPACE=chatbot
SURREALDB_DATABASE=main

# ── Языковая модель ─────────────────────────────────────────────────────────
# Подробно — README.md, раздел 3 «Подключение языковой модели». Значения ниже —
# вариант А, встроенная Ollama. Для своего vLLM (вариант Б) или другого
# сервера (вариант В) замените их по README.
#
# Названия начинаются с OLLAMA_ исторически — подходят для любого
# OpenAI-совместимого сервера.
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama
# Имя модели ровно как в /v1/models сервера (регистр важен). Если моделей
# несколько — берётся первая из списка, что есть на сервере.
ALLOWED_OLLAMA_MODELS=qwen3:14b

# Окно контекста модели.
#   OLLAMA_CONTEXT_LENGTH — окно модели (для встроенной Ollama задаёт ей
#                           num_ctx). Не больше реального окна сервера.
#   LLM_MAX_MODEL_LEN     — окно, под которое приложение рассчитывает длину
#                           ответа. Нужно для Ollama и серверов, не сообщающих
#                           окно в /v1/models. ДЛЯ vLLM — УДАЛИТЬ строку:
#                           vLLM сообщает окно сам, и приложение берёт его оттуда.
# 32768 хватает на обычное совещание. Длинная расшифровка (полтора часа и
# больше) даёт промпт около 32k токенов, и протоколу места не остаётся — для
# таких встреч нужно 65536.
OLLAMA_CONTEXT_LENGTH=32768
LLM_MAX_MODEL_LEN=32768

# Длина ответов: обычной реплики в чате и самого протокола.
OLLAMA_MAX_OUTPUT_TOKENS=4096
OLLAMA_PROTOCOL_MAX_OUTPUT_TOKENS=8192

# true — если сервер отвечает целым JSON на stream:true вместо потока SSE
# (бывает у шлюзов). vLLM и Ollama поток поддерживают — оставить false.
LLM_FORCE_NONSTREAM=false
# none — если сервер отвечает 400 на поля Ollama (think, keep_alive). Нужно
# только строгим шлюзам; vLLM и Ollama не требуют.
# LLM_VENDOR_EXTENSIONS=none

# ТОЛЬКО для встроенной Ollama (вариант А) — раскомментировать обе строки.
# Они включают контейнер ollama и видеокарту для ВСЕХ команд docker compose;
# без них обычный `docker compose up -d` пересоздаст Ollama без видеокарты.
# Со своим vLLM или другим сервером НЕ включать: вторая модель заберёт все
# видеокарты (count: -1) и будет делить видеопамять с вашим сервером.
# COMPOSE_PROFILES=ollama
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# ── Сеть ────────────────────────────────────────────────────────────────────
# По умолчанию порты слушают только 127.0.0.1 — снаружи приложение
# публикуется через reverse-proxy с TLS. Если прокси на другой машине:
# WEB_PORT=0.0.0.0:3000
WEB_PORT=127.0.0.1:3000
SURREAL_PORT=127.0.0.1:8000
# OLLAMA_PORT=127.0.0.1:11434
