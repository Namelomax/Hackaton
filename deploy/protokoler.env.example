# ── Протоколер (Next.js) — .env для сервера yakov@330801 ────────────────────
# Скопируй в ~/protokoler/.env и заполни. НЕ коммить .env в git.
# ВСЕ ключи ПЕРЕВЫПУСТИ (старые скомпрометированы утечкой .env анонимизатора).

# Порт Next.js = 8012. Заняты: 8010/8011 (анонимизатор), 8000 и 3000 (чужие
# процессы, проверено ss). nginx protocol.cpcore.ru → 127.0.0.1:8012.
PORT=8012

# ── LLM (основная модель, OpenAI-совместимый шлюз interfonica) ──────────────
# ВАЖНО: Ollama на ЭТОМ сервере не запущена (11434 закрыт) — ходим по API.
ALLOWED_OLLAMA_MODELS=gemma-4-31b
NEXT_PUBLIC_LOCAL_MODELS=gemma-4-31b
OLLAMA_BASE_URL=https://oui.interfonica.cloud/v1
OLLAMA_API_KEY=<ключ_доступа_к_oui.interfonica.cloud>
CHAT_PROVIDER_DEFAULT=ollama
# Контекст/keep_alive относятся к своему инстансу Ollama; для внешнего шлюза не
# применяются, но keep_alive безвреден. Не выставляй огромный контекст без нужды.
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_KEEP_ALIVE=30m
# ДЕРЖАТЬ true для oui.interfonica.cloud. Шлюз игнорирует stream:true и отвечает
# content-type: application/json вместо text/event-stream — AI SDK такой ответ
# распарсить не может, и пользователь видит «Ответ не удалось сформировать»
# (проверено на сервере 07.08.2026). При true код сам просит stream:false и
# заворачивает JSON в SSE. Минус: текст приходит целиком в конце, а не по токенам.
# false ставить только на шлюзе с настоящим SSE.
LLM_FORCE_NONSTREAM=true

# ── Доступ ──────────────────────────────────────────────────────────────────
# Подпись cookie входа. Без неё каждый перезапуск разлогинивает всех.
#   openssl rand -hex 32
SESSION_SECRET=
# Логины администраторов через запятую. Регистрации нет: пользователей
# заводит админ на /admin, пароль человек придумывает при первом входе.
ADMIN_USERNAMES=

# ── SurrealDB ───────────────────────────────────────────────────────────────
# ВАЖНО: если поднимаешь Surreal через docker-compose протоколера — порт 8000 на
# хосте занят чужим uvicorn. Задай SURREAL_PORT ДО первого `docker compose up`:
SURREAL_PORT=127.0.0.1:8003
# Сам URL приложения (внутри compose-сети — имя сервиса; на хосте — 127.0.0.1:8003):
SURREALDB_URL=<ws://127.0.0.1:8003/rpc или wss://...surreal.cloud/rpc>
SURREALDB_NAMESPACE=<ns>
SURREALDB_DATABASE=<db>
SURREALDB_USER=<user>
SURREALDB_PASSWORD=<перевыпущенный_пароль>
# Проверь, та же ли это база, что у Vercel-прода (иначе пользователи/чаты не
# совпадут): curl -s https://protocol.cpcore.ru/api/health/db | jq .

# ── Прочие ключи (перевыпустить, если были в утёкшем .env) ──────────────────
# GOOGLE_GENERATIVE_AI_API_KEY=<новый>
# SERPAPI_KEY=<новый>
